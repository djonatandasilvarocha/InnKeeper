<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="450.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.back.ServicoCadastroController">
    <children>
        <Label layoutX="160.0" layoutY="30.0" text="Solicitação de Serviço de Quarto - InnKeeper" />

        <Label layoutX="80.0" layoutY="100.0" text="Número do Quarto:" />
        <TextField fx:id="txtNumeroQuarto" layoutX="220.0" prefWidth="280.0" layoutY="95.0" />

        <Label layoutX="80.0" layoutY="155.0" text="Tipo de Serviço:" />
        <TextField fx:id="txtTipoServico" layoutX="220.0" prefWidth="280.0" layoutY="150.0" />

        <Label layoutX="80.0" layoutY="210.0" text="Descrição:" />
        <TextField fx:id="txtDescricao" layoutX="220.0" prefWidth="280.0" layoutY="205.0"/>

        <Label layoutX="80.0" layoutY="265.0" text="Status do Pedido:" />
        <ComboBox fx:id="cbStatus" layoutX="220.0" prefWidth="280.0" layoutY="260.0" />

        <Button fx:id="btnSalvar" layoutX="220.0" layoutY="330.0" mnemonicParsing="false" onAction="#salvarServico" prefWidth="130.0" text="Salvar Pedido" />
        <Button fx:id="btnVoltar" layoutX="370.0" layoutY="330.0" mnemonicParsing="false" onAction="#voltarMenu" prefWidth="130.0" text="Voltar" />
    </children>
</AnchorPane>